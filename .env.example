# ============================================================
# DATABASE
# This project uses PostgreSQL (e.g. Neon, Supabase, Vercel Postgres).
# The schema provider is "postgresql" in prisma/schema.prisma.
# Create a free DB and paste its connection string here:
#   Neon:    https://neon.tech   -> Project -> Connection Details
#   Supabase: https://supabase.com -> Project Settings -> Database -> Connection string (URI)
# Example (do NOT commit real credentials):
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# For Vercel, prefer the pooled connection string (adds ?pgbouncer=true).
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# AUTHENTICATION
# Generate a strong secret: run  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
JWT_SECRET="CHANGE_ME_to_a_long_random_secret_string_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Base URL of the app (used for links in emails, redirects etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# PAYMENTS  (sandbox/test keys)
# Razorpay test keys: https://dashboard.razorpay.com/app/keys
# Stripe test keys:   https://dashboard.stripe.com/test/apikeys
# Leave both empty to use built-in TEST mode / Cash on Delivery.
# ============================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================================
# EMAIL (SMTP)  — used for OTP verification and password-reset emails.
# Leave SMTP_HOST empty to fall back to dev mode (emails are written to
# the server log so flows can be tested without a mail server).
#
# For REAL delivery you must set:
#   SMTP_HOST  — SMTP server hostname, e.g. smtp.gmail.com, smtp-relay.brevo.com
#   SMTP_PORT  — 587 (STARTTLS) or 465 (implicit SSL). Default: 587
#   SMTP_USER  — username (often the full email address or an API-key username)
#   SMTP_PASS  — password / app password / API key
#   MAIL_FROM  — sender shown to recipients, e.g. "NovaCart <no-reply@yourdomain.com>"
#
# Optional TLS tuning:
#   SMTP_SECURE      = "true" to force SSL even on a non-465 port.
#   SMTP_REQUIRE_TLS = "true" to require STARTTLS on the connection.
#
# IMPORTANT: never commit real credentials. Keep them only in .env (git-ignored).
# ============================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EcomStore <no-reply@example.com>"
SMTP_SECURE=""
SMTP_REQUIRE_TLS=""

# ============================================================
# SMS / PHONE OTP
# Provider options:
#   "dev"     - (default) development/test mode. OTPs are logged to
#               the server console so the flow can be tested without
#               SMS credits.
#   "twilio"  - real SMS via Twilio (requires the credentials below).
# Production SMS is never used implicitly.
# ============================================================
SMS_PROVIDER="dev"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ============================================================
# FILE STORAGE
# Local uploads go to /public/uploads by default.
# For production you can provide a Cloudinary config and uploads
# will be sent there instead.
# ============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Stripe publishable (test) key used only on the client for the Stripe payment form
STRIPE_PUBLISHABLE_KEY=""
